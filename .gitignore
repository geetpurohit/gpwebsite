# build output
dist/
.output/

# large local datasets (not committed — download separately, see each project's README.md)
credit-risk-scorecard/data/
causal-uplift/data/

# chart PNGs are a build byproduct; the site renders animated SVG from the JSON instead
public/credit-risk/*.png
public/uplift/*.png
public/experiment/*.png

# compiled résumé preview (build artifact; the served copy is public/Geet_s_Resume.pdf)
/Geet_Purohit_Resume.pdf
/public/Geet_Purohit_Resume_preview.pdf

# dependencies
node_modules/

# astro
.astro/

# environment
.env
.env.production

# logs
*.log
npm-debug.log*

# macOS / editor
.DS_Store
.vscode/

# Universe catalogue data (~220MB) lives in Cloudflare R2, not git.
# The site fetches it at runtime from DATA_BASE in src/pages/projects/universe.astro,
# so the CI build does not need these files. Regenerate locally with scripts/build-*.mjs,
# then publish with: node scripts/sync-r2.mjs universe-data
public/universe/

# Raw Gaia DR3 download (~9.6GB of CSV) — the intermediate that build-gaia.mjs
# reduces into public/universe/. Re-fetch with: node scripts/fetch-gaia.mjs dat
dat/
