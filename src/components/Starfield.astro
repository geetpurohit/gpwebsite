---
---

<canvas id="starfield" aria-hidden="true"></canvas>

<style>
  #starfield {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(58% 48% at 80% 10%, rgba(109,40,217,0.09), transparent 68%),
      radial-gradient(52% 44% at 10% 90%, rgba(124,58,237,0.06), transparent 70%),
      #020104;
  }
</style>

<script>
  type Star = { x: number; y: number; z: number; r: number; base: number; tw: number; phase: number; hue: number };
  type Comet = { x: number; y: number; vx: number; vy: number; len: number };
  type Spark = { ang: number; sp: number };
  type Nova = { x: number; y: number; t: number; max: number; sparks: Spark[] };
  type Hole = { x: number; y: number; vx?: number; vy?: number; R: number; E: number; cf?: number };

  const canvas = document.getElementById('starfield') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: true })!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      || document.documentElement.classList.contains('no-motion');
    const fine = window.matchMedia('(pointer: fine)').matches;
    const TAU = Math.PI * 2;

    let W = 0, H = 0, dpr = 1;
    let stars: Star[] = [];
    let comets: Comet[] = [];
    let novae: Nova[] = [];
    let roamers: Hole[] = [];
    let raf = 0, last = performance.now(), running = true;

    let ppx = 0, ppy = 0, ptx = 0, pty = 0;
    let scrollY = window.scrollY || 0;

    let mainX = 0, mainBaseY = 0, mainR = 0, mainE = 0;

    let tComet = 4000, tNova = 8000, tRoam = 5000;

    const tints = [
      [255, 255, 255],
      [232, 226, 255],
      [205, 186, 255],
      [216, 180, 254],
      [232, 121, 249],
    ];

    /* ---- Keeping the sky off the words ----
       Text has no background to hide behind, so a black hole or a supernova
       lands straight on top of it. Every bright thing this canvas draws fades
       as it nears real glyphs, and holes shrink their lensing too so stars
       stop smearing across a paragraph.

       Rects are measured per *line box* via Range.getClientRects(), not from
       element boxes: a centred column reports its full width as an element but
       only its actual runs as ranges, and using the element box would blank
       the sky across empty gutters where the effect looks its best.

       They're stored in document space and offset by scroll at query time, so
       scrolling costs nothing and only a layout change forces a re-measure. */
    const TEXT_SEL = 'h1,h2,h3,h4,h5,h6,p,li,figcaption,blockquote,a,button,label,.section-label';
    const BUCKET = 96;

    let textEls: Element[] = [];
    let buckets = new Map<number, number[][]>(); // row → [l, t, r, b] in document space
    let textTop = Infinity, textBottom = -Infinity;

    function collectTextEls() {
      // Only leaves: a card wrapping a heading would otherwise blank its whole
      // footprint instead of just the lines inside it.
      textEls = Array.from(document.querySelectorAll(TEXT_SEL))
        .filter((el) => !el.querySelector(TEXT_SEL));
    }

    function measureText() {
      buckets = new Map();
      textTop = Infinity; textBottom = -Infinity;
      const sy = window.scrollY || 0;
      for (const el of textEls) {
        const box = el.getBoundingClientRect();
        if (!box.width || !box.height) continue;
        if (box.bottom < -H || box.top > H * 2) continue; // far offscreen, re-measured on scroll
        const range = document.createRange();
        range.selectNodeContents(el);
        const rects = range.getClientRects();
        const list = rects.length ? rects : [box];
        for (const r of list as ArrayLike<DOMRect>) {
          if (r.width < 3 || r.height < 3) continue;
          const t = r.top + sy, b = r.bottom + sy;
          if (t < textTop) textTop = t;
          if (b > textBottom) textBottom = b;
          const rect = [r.left, t, r.right, b];
          for (let k = Math.floor(t / BUCKET); k <= Math.floor(b / BUCKET); k++) {
            let arr = buckets.get(k);
            if (!arr) buckets.set(k, arr = []);
            arr.push(rect);
          }
        }
      }
    }

    // 1 when the point is clear of any text, easing to 0 as it closes in.
    // `reach` is how far out the object throws light, not its hard radius.
    function clearFactor(x: number, y: number, reach: number) {
      const dy0 = y + (window.scrollY || 0);
      if (dy0 + reach < textTop || dy0 - reach > textBottom) return 1;
      let worst = 0;
      const k0 = Math.floor((dy0 - reach) / BUCKET);
      const k1 = Math.floor((dy0 + reach) / BUCKET);
      for (let k = k0; k <= k1; k++) {
        const arr = buckets.get(k);
        if (!arr) continue;
        for (let i = 0; i < arr.length; i++) {
          const r = arr[i];
          const dx = Math.max(r[0] - x, 0, x - r[2]);
          const dy = Math.max(r[1] - dy0, 0, dy0 - r[3]);
          const d = Math.hypot(dx, dy);
          if (d >= reach) continue;
          const t = 1 - d / reach;
          const s = t * t * (3 - 2 * t); // smoothstep, so the fade has no seam
          if (s > worst) { worst = s; if (worst > 0.995) return 1 - worst; }
        }
      }
      return 1 - worst;
    }

    function build() {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      W = window.innerWidth;
      H = window.innerHeight;
      canvas!.width = Math.floor(W * dpr);
      canvas!.height = Math.floor(H * dpr);
      canvas!.style.width = W + 'px';
      canvas!.style.height = H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const mobile = W < 820;
      mainX = W * (mobile ? 0.78 : 0.815);
      // On narrow screens the text column runs nearly full-width, so there's no
      // safe strip beside it the way there is on desktop — tuck the hole into the
      // quiet space below the hero's content instead of behind it.
      mainBaseY = H * (mobile ? 0.87 : 0.52);
      mainR = Math.max(46, Math.min(W, H) * (mobile ? 0.10 : 0.14));
      mainE = mainR * 1.9;

      const count = Math.min(420, Math.max(110, Math.round((W * H) / 5200)));
      stars = Array.from({ length: count }, () => {
        const z = Math.random();
        return {
          x: Math.random() * W,
          y: Math.random() * H,
          z,
          r: (0.4 + z * 1.5) * (0.7 + Math.random() * 0.8),
          base: 0.22 + Math.random() * 0.5,
          tw: 0.5 + Math.random() * 1.4,
          phase: Math.random() * TAU,
          hue: Math.random() < 0.16 ? 1 + Math.floor(Math.random() * 4) : 0,
        };
      });

      collectTextEls();
      measureText();
    }

    function dot(x: number, y: number, r: number, a: number, tint: number[]) {
      if (a <= 0.02) return;
      ctx.fillStyle = `rgba(${tint[0]},${tint[1]},${tint[2]},${Math.min(1, a)})`;
      ctx.beginPath();
      ctx.arc(x, y, r, 0, TAU);
      ctx.fill();
    }

    function lensDelta(x: number, y: number, holes: Hole[]): [number, number] {
      let dx = 0, dy = 0;
      for (const h of holes) {
        const rx = x - h.x, ry = y - h.y;
        const beta = Math.hypot(rx, ry);
        const E = h.E, outer = E * 4.5, inner = E * 2.6;
        if (beta >= outer) continue;
        let w = 1;
        if (beta > inner) { const t = (beta - inner) / (outer - inner); w = 1 - t * t * (3 - 2 * t); }
        const delta = 0.5 * (Math.sqrt(beta * beta + 4 * E * E) - beta) * w;
        dx += (rx / (beta || 1)) * delta;
        dy += (ry / (beta || 1)) * delta;
      }
      return [dx, dy];
    }

    function lensedRing(cx0: number, cy0: number, r: number, holes: Hole[], stroke: string, lw: number) {
      ctx.strokeStyle = stroke;
      ctx.lineWidth = lw;
      ctx.beginPath();
      const N = 56;
      for (let i = 0; i <= N; i++) {
        const ang = (i / N) * TAU;
        const px = cx0 + Math.cos(ang) * r, py = cy0 + Math.sin(ang) * r;
        const [ex, ey] = lensDelta(px, py, holes);
        const X = px + ex, Y = py + ey;
        if (i === 0) ctx.moveTo(X, Y); else ctx.lineTo(X, Y);
      }
      ctx.stroke();
    }

    function drawStars(now: number, holes: Hole[]) {
      for (const s of stars) {
        const depth = 0.4 + s.z * 1.6;
        const ox = s.x + ppx * depth;
        const oy = s.y + ppy * depth;
        const twinkle = reduce ? 1 : s.base + Math.sin(now * 0.0016 * s.tw + s.phase) * 0.95 * s.base + 0.1;
        let a = Math.max(0, Math.min(1, twinkle));
        const tint = tints[s.hue];

        let dx = 0, dy = 0, mag = 1;
        for (const h of holes) {
          const rx = ox - h.x, ry = oy - h.y;
          const beta = Math.hypot(rx, ry);
          const E = h.E, outer = E * 4.5, inner = E * 2.6;
          if (beta >= outer) continue;
          let w = 1;
          if (beta > inner) { const t = (beta - inner) / (outer - inner); w = 1 - t * t * (3 - 2 * t); }
          const ux = rx / (beta || 1), uy = ry / (beta || 1);
          const delta = 0.5 * (Math.sqrt(beta * beta + 4 * E * E) - beta) * w;
          dx += ux * delta; dy += uy * delta;
          const u = Math.max(beta / E, 1e-4), rt = Math.sqrt(u * u + 4);
          const muP = 0.5 * ((u * u + 2) / (u * rt) + 1);
          mag *= 1 + (Math.min(muP, 3) - 1) * w;
        }

        const x = ox + dx, y = oy + dy;
        a = Math.min(1, a * Math.min(mag, 3.5));
        // Only the big bright ones are worth the per-star lookup, and they're
        // the only ones that actually speckle a paragraph. Dimmed, not removed.
        if (s.r > 1.3 && a > 0.5) a *= 0.4 + clearFactor(x, y, 26) * 0.6;
        dot(x, y, s.r, a, tint);
        if (s.r > 1.3 && a > 0.62) dot(x, y, s.r * 2.4, (a - 0.62) * 0.4, tint);
      }
    }

    function drawHoleShape(x: number, y: number, R: number, cf: number) {
      if (cf <= 0.02) return;
      ctx.save();
      ctx.globalAlpha = cf;
      const glow = ctx.createRadialGradient(x, y, R * 0.9, x, y, R * 1.7);
      glow.addColorStop(0, 'rgba(0,0,0,0)');
      glow.addColorStop(0.4, 'rgba(150,92,235,0.18)');
      glow.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = glow;
      ctx.beginPath(); ctx.arc(x, y, R * 1.7, 0, TAU); ctx.fill();

      ctx.fillStyle = '#000';
      ctx.beginPath(); ctx.arc(x, y, R, 0, TAU); ctx.fill();

      ctx.save();
      ctx.globalCompositeOperation = 'lighter';
      ctx.lineWidth = Math.max(3, R * 0.12);
      ctx.strokeStyle = 'rgba(150,92,235,0.4)';
      ctx.beginPath(); ctx.arc(x, y, R * 1.05, 0, TAU); ctx.stroke();
      ctx.lineWidth = Math.max(1.2, R * 0.03);
      ctx.strokeStyle = 'rgba(245,238,255,0.95)';
      ctx.beginPath(); ctx.arc(x, y, R * 1.015, 0, TAU); ctx.stroke();
      ctx.restore();
      ctx.restore();
    }

    function drawComets() {
      for (let i = comets.length - 1; i >= 0; i--) {
        const c = comets[i];
        c.x += c.vx; c.y += c.vy;
        if (c.x > W + 140 || c.y > H + 140 || c.x < -140 || c.y < -140) { comets.splice(i, 1); continue; }
        const tx = c.x - c.vx * (c.len / 12), ty = c.y - c.vy * (c.len / 12);
        // Comets only dim rather than vanish: they cross the page in a second
        // and blinking out mid-flight would read as a dropped frame.
        ctx.save();
        ctx.globalAlpha = 0.3 + clearFactor(c.x, c.y, 80) * 0.7;
        const g = ctx.createLinearGradient(c.x, c.y, tx, ty);
        g.addColorStop(0, 'rgba(245,240,255,0.95)');
        g.addColorStop(0.35, 'rgba(200,160,255,0.4)');
        g.addColorStop(1, 'rgba(168,85,247,0)');
        ctx.strokeStyle = g;
        ctx.lineWidth = 2.2;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(c.x, c.y);
        ctx.lineTo(tx, ty);
        ctx.stroke();
        dot(c.x, c.y, 2, 0.95, [248, 244, 255]);
        ctx.restore();
      }
    }

    function drawNovae(dt: number, holes: Hole[]) {
      for (let i = novae.length - 1; i >= 0; i--) {
        const n = novae[i];
        n.t += dt;
        const age = n.t / 3200;
        if (age >= 1) { novae.splice(i, 1); continue; }
        const ease = 1 - Math.pow(1 - age, 2.2);
        const fade = 1 - age;

        // A supernova is the brightest thing on the page; landing one on a
        // paragraph is the worst case this system exists to prevent.
        const cf = clearFactor(n.x, n.y, n.max * 1.5);
        if (cf <= 0.02) continue;
        ctx.save();
        ctx.globalAlpha = cf;

        const [cdx, cdy] = lensDelta(n.x, n.y, holes);
        const cx0 = n.x + cdx, cy0 = n.y + cdy;

        // An instant bright flash at birth sells the "event" the way a real
        // camera flash or a supernova's initial brightening would; gone within
        // the first fifth of the burst, well before the shockwave rings expand.
        const flash = Math.max(0, 1 - age / 0.18);
        if (flash > 0.02) {
          const fr = n.max * 0.55;
          const fg = ctx.createRadialGradient(cx0, cy0, 0, cx0, cy0, fr);
          fg.addColorStop(0, `rgba(255,255,255,${flash * 0.9})`);
          fg.addColorStop(0.35, `rgba(240,220,255,${flash * 0.5})`);
          fg.addColorStop(1, 'rgba(168,85,247,0)');
          ctx.fillStyle = fg;
          ctx.beginPath(); ctx.arc(cx0, cy0, fr, 0, TAU); ctx.fill();
        }

        const coreA = Math.max(0, 1 - age * 1.4);
        if (coreA > 0.02) {
          const cr = 4 + age * 22;
          const cg = ctx.createRadialGradient(cx0, cy0, 0, cx0, cy0, cr * 3.4);
          cg.addColorStop(0, `rgba(255,255,255,${coreA})`);
          cg.addColorStop(0.28, `rgba(245,228,255,${coreA * 0.75})`);
          cg.addColorStop(0.58, `rgba(232,121,249,${coreA * 0.38})`);
          cg.addColorStop(1, 'rgba(168,85,247,0)');
          ctx.fillStyle = cg;
          ctx.beginPath(); ctx.arc(cx0, cy0, cr * 3.4, 0, TAU); ctx.fill();
        }

        // The gravitationally lensed shockwave rings are the star of the
        // effect now (three, at different radii/opacities) rather than the
        // straight spoke lines this used to draw, which just read as an
        // asterisk popping rather than a supernova.
        lensedRing(n.x, n.y, ease * n.max * 1.3,  holes, `rgba(200,170,255,${fade * 0.24})`, Math.max(0.6, 1.6 * fade));
        lensedRing(n.x, n.y, ease * n.max,        holes, `rgba(236,214,255,${fade * 0.85})`, Math.max(1, 4.2 * fade));
        lensedRing(n.x, n.y, ease * n.max * 0.62, holes, `rgba(255,150,240,${fade * 0.55})`, Math.max(0.8, 2.6 * fade));

        for (const sp of n.sparks) {
          const d = ease * n.max * sp.sp;
          const px = n.x + Math.cos(sp.ang) * d, py = n.y + Math.sin(sp.ang) * d;
          const [ex, ey] = lensDelta(px, py, holes);
          dot(px + ex, py + ey, Math.max(0.6, 1.8 * fade), fade * 0.85, [255, 240, 255]);
        }
        ctx.restore();
      }
    }

    function spawnComet() {
      const fromLeft = Math.random() < 0.5;
      const x = fromLeft ? -60 : Math.random() * W * 0.5;
      const y = fromLeft ? Math.random() * H * 0.4 : -60;
      const ang = Math.PI / 4 + (Math.random() - 0.5) * 0.5;
      const sp = 8 + Math.random() * 6;
      comets.push({ x, y, vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp, len: 90 + Math.random() * 130 });
    }

    function spawnNova() {
      const s = stars[(Math.random() * stars.length) | 0];
      if (!s) return;
      const n = 10 + ((Math.random() * 8) | 0);
      const sparks: Spark[] = Array.from({ length: n }, () => ({ ang: Math.random() * TAU, sp: 0.55 + Math.random() * 0.5 }));
      novae.push({ x: s.x, y: s.y, t: 0, max: 130 + Math.random() * 140, sparks });
    }

    function spawnRoamer() {
      const R = Math.max(22, Math.min(W, H) * 0.038);
      const m = R * 5;
      const edge = (Math.random() * 4) | 0;
      let x = 0, y = 0;
      if (edge === 0) { x = -m; y = Math.random() * H; }
      else if (edge === 1) { x = W + m; y = Math.random() * H; }
      else if (edge === 2) { x = Math.random() * W; y = -m; }
      else { x = Math.random() * W; y = H + m; }
      const tx = W * (0.2 + Math.random() * 0.6), ty = H * (0.2 + Math.random() * 0.6);
      const ang = Math.atan2(ty - y, tx - x) + (Math.random() - 0.5) * 0.5;
      const dur = 11000 + Math.random() * 8000;
      const sp = (Math.hypot(W, H) + m * 2) / dur;
      roamers.push({ x, y, vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp, R, E: R * 2.4 });
    }

    function frame(now: number) {
      const dt = Math.min(now - last, 50);
      last = now;
      ctx.clearRect(0, 0, W, H);

      ppx += (ptx - ppx) * 0.05;
      ppy += (pty - ppy) * 0.05;

      const mainY = mainBaseY - scrollY;
      const mainOn = mainY > -mainR * 5 && mainY < H + mainR * 5;

      if (!reduce) {
        for (let i = roamers.length - 1; i >= 0; i--) {
          const r = roamers[i];
          r.x += r.vx * dt; r.y += r.vy * dt;
          const m = r.E * 5;
          if (r.x < -m || r.x > W + m || r.y < -m || r.y > H + m) roamers.splice(i, 1);
        }
      }

      // Lensing shrinks with the hole's visibility, so stars stop smearing
      // across a paragraph that the hole itself has already faded out of.
      // Reach tracks the hole's own visible extent (the glow reaches ~1.7R), so
      // merely sitting beside a column dims it a little while actually covering
      // the words takes it out. Any wider and the hero's hole never shows at all.
      const holes: Hole[] = [];
      for (const r of roamers) {
        const cf = clearFactor(r.x, r.y, r.R * 1.35);
        holes.push({ x: r.x, y: r.y, R: r.R, E: r.E * cf, cf });
      }
      if (mainOn) {
        const cf = clearFactor(mainX, mainY, mainR * 1.35);
        holes.push({ x: mainX, y: mainY, R: mainR, E: mainE * cf, cf });
      }

      drawStars(now, holes);

      ctx.globalCompositeOperation = 'lighter';
      drawNovae(dt, holes);
      drawComets();
      ctx.globalCompositeOperation = 'source-over';

      for (const h of holes) drawHoleShape(h.x, h.y, h.R, h.cf ?? 1);

      (window as any).__bhs = holes;

      if (!reduce) {
        tComet -= dt; tNova -= dt; tRoam -= dt;
        if (tComet <= 0) { spawnComet(); tComet = 6000 + Math.random() * 9000; }
        if (tNova <= 0) { spawnNova(); tNova = 8000 + Math.random() * 11000; }
        if (tRoam <= 0 && roamers.length < 1) { spawnRoamer(); tRoam = 9000 + Math.random() * 12000; }
      }

      if (running) raf = requestAnimationFrame(frame);
    }

    function start() { if (!running) { running = true; last = performance.now(); raf = requestAnimationFrame(frame); } }
    function stop() { running = false; cancelAnimationFrame(raf); }

    if (fine) {
      window.addEventListener('pointermove', (e) => {
        ptx = (e.clientX / W - 0.5) * 16;
        pty = (e.clientY / H - 0.5) * 16;
      }, { passive: true });
    }
    // Text only moves relative to the viewport when the page scrolls, and the
    // rects are already stored in document space. What a scroll does change is
    // which elements are close enough to be worth measuring, and reveal
    // animations settle as they come into view, so re-measure on a throttle.
    let lastMeasure = 0;
    function maybeMeasure() {
      const t = performance.now();
      if (t - lastMeasure < 180) return;
      lastMeasure = t;
      measureText();
    }

    window.addEventListener('scroll', () => {
      scrollY = window.scrollY || 0;
      maybeMeasure();
    }, { passive: true });

    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else start(); });

    let rt: number;
    window.addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(build, 150); });

    build();
    // Web fonts and late layout both move every glyph on the page.
    window.addEventListener('load', () => { collectTextEls(); measureText(); });
    (document as any).fonts?.ready?.then(() => { collectTextEls(); measureText(); });

    raf = requestAnimationFrame(frame);
  }
</script>
